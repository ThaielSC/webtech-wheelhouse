<% content_for :title, repair_name(@repair) %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= repair_name(@repair) %></h1>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Edit repair", edit_repair_path(@repair), class: "btn btn-primary" %>
      <%= button_to "Delete repair", repair_path(@repair), method: :delete,
          form: { data: { turbo_confirm: "Delete this repair and its photos and diagnosis?" } }, class: "btn btn-danger" %>
      <%= link_to "Back to repairs", repairs_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3">Bike</dt>
        <dd class="col-sm-9">
          <%= link_to bike_name(@repair.bike), bike_path(@repair.bike) %> · <%= link_to @repair.bike.customer.name, customer_path(@repair.bike.customer) %>
        </dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><span class="badge text-bg-secondary"><%= @repair.status_label %></span></dd>

        <dt class="col-sm-3">Promised for</dt>
        <dd class="col-sm-9"><%= day(@repair.promised_on) %></dd>

        <dt class="col-sm-3">Taken in by</dt>
        <dd class="col-sm-9">
          <% if @repair.user %>
            <% if @repair.user.staff_member %>
              <%= link_to @repair.user.staff_member.name, staff_member_path(@repair.user.staff_member) %>
            <% else %>
              <%= @repair.user.email_address %>
            <% end %>
          <% else %>
            <%= link_to @repair.intake_by_staff.name, staff_member_path(@repair.intake_by_staff) %>
          <% end %>
        </dd>

        <dt class="col-sm-3">Mechanic</dt>
        <dd class="col-sm-9">
          <%= @repair.assigned_mechanic ? link_to(@repair.assigned_mechanic.name, staff_member_path(@repair.assigned_mechanic)) : "Not assigned" %>
        </dd>

        <dt class="col-sm-3">Customer approval</dt>
        <dd class="col-sm-9">
          <%= @repair.approved_by_customer.nil? ? "Pending" : (@repair.approved_by_customer ? "Approved" : "Rejected") %>
        </dd>

        <% if @repair.completed_at %>
          <dt class="col-sm-3">Completed</dt>
          <dd class="col-sm-9"><%= instant(@repair.completed_at) %></dd>
        <% end %>

        <% if @repair.picked_up_at %>
          <dt class="col-sm-3">Picked up</dt>
          <dd class="col-sm-9"><%= instant(@repair.picked_up_at) %></dd>
        <% end %>
      </dl>
    </div>
  </div>

  <h2 class="h3">Intake photos</h2>
  <% if @repair.intake_photos.any? %>
    <div class="row g-3 mb-4">
      <% @repair.intake_photos.each_with_index do |photo, index| %>
        <div class="col-md-6">
          <figure class="figure">
            <%= link_to rails_blob_path(photo, disposition: "inline") do %>
              <%= image_tag photo.variant(:detail), alt: "Intake photo #{index + 1} of #{bike_name(@repair.bike)} for #{repair_name(@repair)}", class: "figure-img img-fluid rounded" %>
            <% end %>
            <figcaption class="figure-caption mb-2">Intake photo <%= index + 1 %></figcaption>
            <%= button_to "Remove photo #{index + 1}", intake_photo_repair_path(@repair, attachment_id: photo.id),
              method: :delete, class: "btn btn-sm btn-outline-danger",
              form: { data: { turbo_confirm: "Remove this intake photo permanently?" } } %>
          </figure>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="alert alert-info">No intake photos for this repair.</p>
  <% end %>

  <h2 class="h3">Diagnosis</h2>
  <% if @repair.diagnosis.present? %>
    <div class="card mb-4"><div class="card-body"><%= @repair.diagnosis %></div></div>
  <% else %>
    <p class="alert alert-info">No diagnosis yet.</p>
  <% end %>

  <h2 class="h3">Services charged</h2>
  <% if @repair_items.any? %>
    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th>Service</th>
            <th>Notes</th>
            <th class="text-end">Charged price</th>
          </tr>
        </thead>
        <tbody>
          <% @repair_items.each do |repair_item| %>
            <tr>
              <td><%= link_to repair_item.service.name, service_path(repair_item.service) %></td>
              <td><%= repair_item.notes.presence || "—" %></td>
              <td class="text-end"><%= money(repair_item.charged_price) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="2" class="text-end">Total</th>
            <th class="text-end"><%= money(@repair.total) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  <% else %>
    <p class="alert alert-info">No services have been charged to this repair.</p>
  <% end %>
</div>
