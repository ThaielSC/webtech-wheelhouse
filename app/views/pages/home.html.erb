<div class="container my-4">
  <h1>Wheelhouse Bicycle Workshop</h1>
  <p class="lead">
    Welcome to Wheelhouse. We provide bicycle maintenance, repairs, and standard price services.
  </p>

  <hr class="my-4">

  <div class="row">
    <div class="col-md-4 mb-3">
      <h2>Customers</h2>
      <p>See customers and the bikes they bring to the workshop.</p>
      <%= link_to "View Customers", customers_path, class: "btn btn-primary" %>
    </div>

    <div class="col-md-4 mb-3">
      <h2>Bikes</h2>
      <p>Browse every bike currently known to Wheelhouse.</p>
      <%= link_to "View Bikes", bikes_path, class: "btn btn-primary" %>
    </div>

    <div class="col-md-4 mb-3">
      <h2>Repairs</h2>
      <p>Follow repair status and promised collection dates.</p>
      <%= link_to "View Repairs", repairs_path, class: "btn btn-primary" %>
    </div>

    <div class="col-md-4 mb-3">
      <h2>Staff</h2>
      <p>Meet the counter staff and mechanics.</p>
      <%= link_to "View Staff", staff_members_path, class: "btn btn-primary" %>
    </div>
    <div class="col-md-4 mb-3">
      <h2>Services</h2>
      <p>Check our complete price list for all bicycle repairs.</p>
      <%= link_to "View Services", services_path, class: "btn btn-primary" %>
    </div>

    <div class="col-md-4 mb-3">
      <h2>Visiting Us</h2>
      <p>Opening hours, location, and how bike drop-off works.</p>
      <%= link_to "Visit Workshop", workshop_path, class: "btn btn-secondary" %>
    </div>

    <div class="col-md-4 mb-3">
      <h2>About</h2>
      <p>Learn more about our team and workshop philosophy.</p>
      <%= link_to "About Us", about_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
