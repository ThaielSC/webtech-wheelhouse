<div class="container my-4">
  <h1>Wheelhouse Bicycle Workshop</h1>
  <p class="lead">
    Welcome to Wheelhouse. We provide bicycle maintenance, repairs, and standard price services.
  </p>

  <hr class="my-4">

  <div class="row">
    <div class="col-md-4 mb-3">
      <h2>Services</h2>
      <p>Check our complete price list for all bicycle repairs.</p>
      <%= link_to "View Services", services_path, class: "btn btn-primary" %>
    </div>

    <div class="col-md-4 mb-3">
      <h2>Visiting Us</h2>
      <p>Opening hours, location, and how bike drop-off works.</p>
      <%= link_to "Visit Workshop", workshop_path, class: "btn btn-secondary" %>
    </div>

    <div class="col-md-4 mb-3">
      <h2>About</h2>
      <p>Learn more about our team and workshop philosophy.</p>
      <%= link_to "About Us", about_path, class: "btn btn-secondary" %>
    </div>
  </div>
</div>
