<div class="container py-4">
  <h1 class="mb-3">Workshop Services &amp; Price List</h1>
  <p class="lead text-secondary mb-4">
    The complete list of repair and maintenance services available at Wheelhouse. All work is performed by our certified mechanics with transparent, fixed labor pricing.
  </p>

  <div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
      <thead class="table-dark">
        <tr>
          <th scope="col" style="width: 30%;">Service</th>
          <th scope="col" style="width: 55%;">Description</th>
          <th scope="col" class="text-end" style="width: 15%;">Standard Price</th>
        </tr>
      </thead>
      <tbody>
        <% @services.each do |service| %>
          <tr>
            <td class="fw-semibold"><%= service[:name] %></td>
            <td class="text-muted"><%= service[:description] %></td>
            <td class="text-end fw-bold text-success">$<%= service[:price] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
