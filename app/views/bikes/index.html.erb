<% content_for :title, "Bikes" %>

<div class="container py-4">
  <h1>Bikes</h1>

  <% if @bikes.any? %>
    <div class="table-responsive shadow-sm rounded">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Bike</th>
            <th>Owner</th>
            <th>Color</th>
            <th>Serial number</th>
          </tr>
        </thead>
        <tbody>
          <%= render @bikes %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="alert alert-info">There are no bikes yet.</p>
  <% end %>
</div>
