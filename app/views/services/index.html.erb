<% content_for :title, "Services" %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Workshop Services &amp; Price List</h1>
    <%= link_to "New service", new_service_path, class: "btn btn-primary" %>
  </div>
  <p class="lead text-secondary mb-4">The complete list of repair and maintenance services available at Wheelhouse.</p>

  <% if @services.any? %>
    <div class="table-responsive shadow-sm rounded">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Service</th>
            <th>Description</th>
            <th class="text-end">Standard price</th>
          </tr>
        </thead>
        <tbody>
          <%= render @services %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="alert alert-info">There are no services yet.</p>
  <% end %>
</div>
