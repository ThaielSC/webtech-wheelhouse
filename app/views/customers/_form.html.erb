<%= form_with model: customer do |form| %>
  <%= render "shared/form_errors", record: customer %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: form_field_class(customer, :name) %>
    <%= render "shared/field_errors", record: customer, attribute: :name %>
  </div>

  <div class="mb-3">
    <%= form.label :phone, class: "form-label" %>
    <%= form.text_field :phone, class: form_field_class(customer, :phone) %>
    <%= render "shared/field_errors", record: customer, attribute: :phone %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", customer.persisted? ? customer_path(customer) : customers_path, class: "btn btn-outline-secondary" %>
<% end %>
