<% content_for :title, @customer.name %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= @customer.name %></h1>
    <div class="d-flex flex-wrap gap-2">
      <%= link_to "Edit customer", edit_customer_path(@customer), class: "btn btn-primary" %>
      <%= button_to "Delete customer", customer_path(@customer), method: :delete,
          data: { turbo_confirm: "Delete customer #{@customer.name}?" }, class: "btn btn-danger" %>
      <%= link_to "Back to customers", customers_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h5">Contact</h2>
      <p class="mb-0"><%= @customer.phone %></p>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h3">Bikes</h2>
    <%= link_to "Add bike", new_bike_path(bike: { customer_id: @customer.id }), class: "btn btn-primary" %>
  </div>
  <% if @bikes.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th>Bike</th>
            <th>Owner</th>
            <th>Color</th>
            <th>Serial number</th>
          </tr>
        </thead>
        <tbody>
          <%= render @bikes %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="alert alert-info">This customer has no bikes yet.</p>
  <% end %>
</div>
