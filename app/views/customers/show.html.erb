<% content_for :title, @customer.name %>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h1><%= @customer.name %></h1>
    <%= link_to "Back to customers", customers_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <h2 class="h5">Contact</h2>
      <p class="mb-0"><%= @customer.phone %></p>
    </div>
  </div>

  <h2 class="h3">Bikes</h2>
  <% if @customer.bikes.any? %>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead>
          <tr>
            <th>Bike</th>
            <th>Owner</th>
            <th>Color</th>
            <th>Serial number</th>
          </tr>
        </thead>
        <tbody>
          <%= render @customer.bikes.order(:make, :model, :serial_number) %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="alert alert-info">This customer has no bikes yet.</p>
  <% end %>
</div>
