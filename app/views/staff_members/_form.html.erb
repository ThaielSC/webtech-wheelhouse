<%= form_with model: staff_member do |form| %>
  <%= render "shared/form_errors", record: staff_member %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: form_field_class(staff_member, :name) %>
    <%= render "shared/field_errors", record: staff_member, attribute: :name %>
  </div>

  <div class="mb-3">
    <%= form.label :role, class: "form-label" %>
    <%= form.text_field :role, class: form_field_class(staff_member, :role) %>
    <%= render "shared/field_errors", record: staff_member, attribute: :role %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", staff_member.persisted? ? staff_member_path(staff_member) : staff_members_path, class: "btn btn-outline-secondary" %>
<% end %>
